<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#100D18"
    android:padding="20dp">

    <!-- LOGO GAMEZONE -->
    <TextView
        android:id="@+id/txtLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GAMEZONE"
        android:textColor="#9C27FF"
        android:textSize="32sp"
        android:textStyle="bold"
        android:fontFamily="sans"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- CAPA DO JOGO -->
    <ImageView
        android:id="@+id/imgCapa"
        android:layout_width="250dp"
        android:layout_height="330dp"
        android:layout_marginTop="20dp"
        android:contentDescription="Capa do jogo"
        android:scaleType="centerCrop"
        android:src="@drawable/capa_jogo"
        app:layout_constraintTop_toBottomOf="@id/txtLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- SELO DE CLASSIFICAÇÃO -->
    <TextView
        android:id="@+id/txtSelo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="#FFFFFF"
        android:gravity="center"
        android:text="16"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/imgCapa"
        app:layout_constraintTop_toTopOf="@id/imgCapa"
        android:translationX="-8dp"
        android:translationY="8dp" />

    <!-- NOME DO JOGO -->
    <TextView
        android:id="@+id/txtNomeJogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Cyber Warriors"
        android:textColor="#FFFFFF"
        android:textSize="25sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/imgCapa"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- TEXTO PLATAFORMA -->
    <TextView
        android:id="@+id/txtPlataforma"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Escolha sua plataforma:"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        app:layout_constraintTop_toBottomOf="@id/txtNomeJogo"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- RADIO GROUP -->
    <RadioGroup
        android:id="@+id/radioGroupPlataformas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/txtPlataforma"
        app:layout_constraintStart_toStartOf="parent">

        <RadioButton
            android:id="@+id/radioPC"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PC"
            android:textColor="#FFFFFF"
            android:buttonTint="#9C27FF" />

        <RadioButton
            android:id="@+id/radioPlayStation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PlayStation"
            android:textColor="#FFFFFF"
            android:buttonTint="#9C27FF" />

        <RadioButton
            android:id="@+id/radioXbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Xbox"
            android:textColor="#FFFFFF"
            android:buttonTint="#9C27FF" />

    </RadioGroup>

    <!-- CHECKBOX ISOLADO NO CANTO INFERIOR DIREITO -->
    <CheckBox
        android:id="@+id/checkNotificacoes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Receber notificações de promoções"
        android:textColor="#FFFFFF"
        android:buttonTint="#9C27FF"
        android:layout_marginBottom="10dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>